# systemd unit for the Raspberry Pi.
#   sudo cp deploy/csfloat-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now csfloat-watcher
#   journalctl -u csfloat-watcher -f
[Unit]
Description=CSFloat Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/csfloat-watcher
EnvironmentFile=/opt/csfloat-watcher/.env.local
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
