{
  "name": "csfloat-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "graphql-codegen",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "dev": "concurrently -k -n next,codegen -c blue,magenta \"next dev\" \"graphql-codegen --watch\"",
    "build": "graphql-codegen && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch:run": "tsx scripts/run-watch.ts",
    "spike": "tsx scripts/spike.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.0.0",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@apollo/server": "^5.5.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "croner": "^9.1.0",
    "graphql": "^16.11.0",
    "next": "^16.0.0",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "styled-components": "6.5.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ],
    "ignoredBuiltDependencies": [
      "@apollo/protobufjs"
    ]
  }
}
