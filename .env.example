# Copy to .env.local and fill in.

# CSFloat API key: csfloat.com -> Profile -> Developers
CSFLOAT_API_KEY=

# Discord channel webhook: Channel settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Public URL of this app (used for "open in app" links in Discord). Optional.
APP_URL=http://raspberrypi.local:3000

# Where snapshots, seen-sets and run history are stored. Prefer a USB SSD on the Pi.
DATA_DIR=./data

# Timezone for cron schedules.
TZ=Europe/Stockholm

# Minimum gap between CSFloat requests (ms). 2000 = at most 30 requests/minute.
CSFLOAT_MIN_INTERVAL_MS=2000

LOG_LEVEL=info
